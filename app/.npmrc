# The Docker container (Alpine/musl) and the glibc host share node_modules
# via a bind mount. rolldown ships one native binding per platform and npm
# refuses the mismatched one (`notsup`) unless forced, so both bindings are
# pinned in devDependencies and installed regardless; rolldown picks the
# right one at runtime. Keep `npm install`/`npm ci` symmetrical on both
# platforms or the other environment breaks.
force=true
