{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "planner",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "draft": true,
      "force-tag-creation": true,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "refactor", "section": "Changed" },
        { "type": "revert", "section": "Removed" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": "api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "api/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "api/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "app/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "app/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "app/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
