# Copy this file to .env and fill in real values.
# Development compose.yml reads from .env; production compose.prod.yml
# uses Docker secrets mounted from ./secrets/ (see compose.prod.yml).

# PostgreSQL
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=planner

# CORS (must match the frontend URL your users will access)
CORS_ORIGIN=https://planner.local

# Email (password reset). Leave RESEND_API_KEY empty to have the API print
# reset links to its own console instead of sending mail - the whole flow
# works locally without a Resend account. EMAIL_FROM must be on a domain
# verified with Resend before real delivery works.
RESEND_API_KEY=
EMAIL_FROM=noreply@planner.local

# --- Multi-agent / worktree isolation (optional) ---
# Override these only when running a second instance from a git worktree.
# The defaults work for the main branch without any changes.
#
# COMPOSE_PROJECT_NAME=planner-my-feature   # Docker project namespace
# APP_SUBDOMAIN=my-feature                  # Traefik Host: https://my-feature.local

# --- Container user (optional) ---
# The app and api containers bind-mount ./app and ./api, so files they create
# (node_modules, Vite's dep cache) are owned on the host by whoever the
# container runs as. The default suits the common single-user host; set this to
# your own `id -u`:`id -g` if that is not 1000:1000, otherwise those files come
# back root-owned and cannot be removed without sudo.
#
# DOCKER_USER=1000:1000
